@model Edulytics.Services.Auditing.AuditQueryPage
@inject Microsoft.Extensions.Localization.IStringLocalizer<Edulytics.Web.AuditResource> T

@{
    ViewData["Title"] = T["Title"];
}

<div class="container-fluid py-4 audit-page">
    <div class="mb-4">
        <h1 class="h3">@T["Title"]</h1>
        <p class="text-muted mb-0">
            @T["Subtitle"]
        </p>
    </div>

    <form method="get"
          asp-controller="Audit"
          asp-action="Index"
          class="card card-body mb-4 audit-filter-card">
        <div class="row g-3">

            @if (Model.CanSelectSchool)
            {
                <div class="col-md-4">
                    <label class="form-label"
                           for="schoolId">
                        @T["SchoolId"]
                    </label>
                    <input class="form-control"
                           id="schoolId"
                           name="schoolId"
                           value="@Model.Query.SchoolId" />
                </div>
            }

            <div class="col-md-4">
                <label class="form-label"
                       for="auditAction">
                    @T["Action"]
                </label>
                <input class="form-control"
                       id="auditAction"
                       name="auditAction"
                       placeholder="@T["ActionPlaceholder"]"
                       value="@Model.Query.Action" />
            </div>

            <div class="col-md-4">
                <label class="form-label"
                       for="entityType">
                    @T["EntityType"]
                </label>
                <input class="form-control"
                       id="entityType"
                       name="entityType"
                       value="@Model.Query.EntityType" />
            </div>

            <div class="col-md-4">
                <label class="form-label"
                       for="correlationId">
                    @T["CorrelationId"]
                </label>
                <input class="form-control"
                       id="correlationId"
                       name="correlationId"
                       placeholder="@T["CorrelationIdPlaceholder"]"
                       value="@Model.Query.CorrelationId" />
            </div>

            <div class="col-md-4">
                <label class="form-label"
                       for="actorUserId">
                    @T["ActorUserId"]
                </label>
                <input class="form-control"
                       id="actorUserId"
                       name="actorUserId"
                       placeholder="@T["ActorUserIdPlaceholder"]"
                       value="@Model.Query.ActorUserId" />
            </div>

            <div class="col-md-4">
                <label class="form-label"
                       for="actorRole">
                    @T["Actor"]
                </label>
                <select class="form-select"
                        id="actorRole"
                        name="actorRole">
                    @if (string.IsNullOrWhiteSpace(Model.Query.ActorRole))
                    {
                        <option value="" selected>@T["AllActors"]</option>
                    }
                    else
                    {
                        <option value="">@T["AllActors"]</option>
                    }

                    @foreach (var option in new[]
                    {
                        ("System", T["DisplayActorSystem"].Value),
                        ("SuperAdmin", T["DisplayRoleSuperAdmin"].Value),
                        ("SchoolAdmin", T["DisplayRoleSchoolAdmin"].Value),
                        ("SubjectSupervisor", T["DisplayRoleSubjectSupervisor"].Value),
                        ("Teacher", T["DisplayRoleTeacher"].Value),
                        ("Student", T["DisplayRoleStudent"].Value)
                    })
                    {
                        if (Model.Query.ActorRole == option.Item1)
                        {
                            <option value="@option.Item1" selected>
                                @option.Item2
                            </option>
                        }
                        else
                        {
                            <option value="@option.Item1">
                                @option.Item2
                            </option>
                        }
                    }
                </select>
            </div>

            <div class="col-md-4">
                <label class="form-label"
                       for="fromUtc">
                    @T["FromUtc"]
                </label>
                <input class="form-control"
                       id="fromUtc"
                       name="fromUtc"
                       value="@Model.Query.FromUtc" />
            </div>

            <div class="col-md-4">
                <label class="form-label"
                       for="toUtc">
                    @T["ToUtc"]
                </label>
                <input class="form-control"
                       id="toUtc"
                       name="toUtc"
                       value="@Model.Query.ToUtc" />
            </div>

            <div class="col-md-2">
                <label class="form-label"
                       for="pageSize">
                    @T["PageSize"]
                </label>
                <select class="form-select"
                        id="pageSize"
                        name="pageSize">
                    @foreach (var size in new[] { 10, 25, 50, 100 })
                    {
                        if (Model.PageSize == size)
                        {
                            <option value="@size"
                                    selected>
                                @size
                            </option>
                        }
                        else
                        {
                            <option value="@size">
                                @size
                            </option>
                        }
                    }
                </select>
            </div>

            <div class="col-12 d-flex gap-2">
                <button type="submit"
                        class="btn btn-primary">
                    @T["Search"]
                </button>

                <a asp-controller="Audit"
                   asp-action="Index"
                   class="btn btn-outline-secondary">
                    @T["Clear"]
                </a>
            </div>
        </div>
    </form>

    <div class="d-flex justify-content-between
                align-items-center mb-3 audit-summary-bar">
        <strong>
            @T["TotalEntries"]: @Model.TotalCount
        </strong>

        <span>
            @T["Page"] @Model.Page
            @T["Of"] @Model.TotalPages
        </span>
    </div>

    @if (Model.Items.Count == 0)
    {
        <div class="alert alert-secondary">
            @T["NoEntries"]
        </div>
    }
    else
    {
        <div class="audit-table-shell">
            <div class="audit-table-scroll"
                 tabindex="0"
                 aria-label="@T["Title"]">
                <table class="table audit-table align-middle mb-0">
                    <thead>
                        <tr>
                            <th class="audit-col-time">@T["Timestamp"]</th>
                            <th class="audit-col-school">@T["SchoolId"]</th>
                            <th class="audit-col-actor">@T["Actor"]</th>
                            <th class="audit-col-action">@T["Action"]</th>
                            <th class="audit-col-entity">@T["Entity"]</th>
                            <th class="audit-col-correlation">@T["CorrelationId"]</th>
                            <th class="audit-col-details">@T["Result"] / @T["Changes"]</th>
                        </tr>
                    </thead>
                    <tbody>
                    @foreach (var item in Model.Items)
                    {
                        var actorRoleLabel =
                            item.ActorRole switch
                            {
                                "System" => T["DisplayActorSystem"].Value,
                                "SuperAdmin" => T["DisplayRoleSuperAdmin"].Value,
                                "SchoolAdmin" => T["DisplayRoleSchoolAdmin"].Value,
                                "SubjectSupervisor" => T["DisplayRoleSubjectSupervisor"].Value,
                                "Teacher" => T["DisplayRoleTeacher"].Value,
                                "Student" => T["DisplayRoleStudent"].Value,
                                _ => item.ActorRole
                            };

                        <tr>
                            <td class="audit-cell-time">
                                <time class="audit-time-value"
                                      datetime="@item.OccurredAtUtc.ToString("O")"
                                      title="@item.OccurredAtUtc.ToString("u")">
                                    <span class="audit-time-date">
                                        @item.OccurredAtUtc.ToString("yyyy-MM-dd")
                                    </span>
                                    <span class="audit-time-clock">
                                        @item.OccurredAtUtc.ToString("HH:mm:ss") UTC
                                    </span>
                                </time>
                            </td>

                            <td class="audit-cell-school">
                                @if (item.SchoolId.HasValue)
                                {
                                    <code class="audit-id" title="@item.SchoolId">
                                        @item.SchoolId
                                    </code>
                                }
                                else
                                {
                                    <span class="audit-scope-platform">
                                        @T["PlatformScope"]
                                    </span>
                                }
                            </td>

                            <td class="audit-cell-actor">
                                <code class="audit-id" title="@item.ActorUserId">
                                    @item.ActorUserId
                                </code>
                                <span class="audit-role-badge">
                                    @actorRoleLabel
                                </span>
                            </td>

                            <td class="audit-cell-action">
                                <code class="audit-action-code" title="@item.Action">
                                    @item.Action
                                </code>
                            </td>

                            <td class="audit-cell-entity">
                                <span class="audit-entity-type" title="@item.EntityType">
                                    @item.EntityType
                                </span>
                                <code class="audit-id audit-entity-id" title="@item.EntityId">
                                    @item.EntityId
                                </code>
                            </td>

                            <td class="audit-cell-correlation">
                                <code class="audit-id" title="@item.CorrelationId">
                                    @item.CorrelationId
                                </code>
                            </td>

                            <td class="audit-cell-details">
                                <div class="audit-result-summary">
                                    @item.ResultSummary
                                </div>
                                <div class="audit-result-meta">
                                    @item.Feature / @item.Source
                                </div>

                                @if (!string.IsNullOrWhiteSpace(item.OldValuesJson) ||
                                     !string.IsNullOrWhiteSpace(item.NewValuesJson))
                                {
                                    <details class="audit-change-details">
                                        <summary>@T["Changes"]</summary>

                                        @if (!string.IsNullOrWhiteSpace(item.OldValuesJson))
                                        {
                                            <div class="audit-change-block">
                                                <strong>@T["OldValues"]</strong>
                                                <pre>@item.OldValuesJson</pre>
                                            </div>
                                        }

                                        @if (!string.IsNullOrWhiteSpace(item.NewValuesJson))
                                        {
                                            <div class="audit-change-block">
                                                <strong>@T["NewValues"]</strong>
                                                <pre>@item.NewValuesJson</pre>
                                            </div>
                                        }
                                    </details>
                                }
                            </td>
                        </tr>
                    }
                    </tbody>
                </table>
            </div>
        </div>
    }

    <div class="d-flex justify-content-between mt-3">
        @if (Model.Page > 1)
        {
            <a asp-controller="Audit"
               asp-action="Index"
               asp-route-schoolId="@Model.Query.SchoolId"
               asp-route-auditAction="@Model.Query.Action"
               asp-route-entityType="@Model.Query.EntityType"
               asp-route-correlationId="@Model.Query.CorrelationId"
               asp-route-actorUserId="@Model.Query.ActorUserId"
               asp-route-actorRole="@Model.Query.ActorRole"
               asp-route-fromUtc="@Model.Query.FromUtc"
               asp-route-toUtc="@Model.Query.ToUtc"
               asp-route-page="@(Model.Page - 1)"
               asp-route-pageSize="@Model.PageSize"
               class="btn btn-outline-secondary">
                @T["Previous"]
            </a>
        }
        else
        {
            <span></span>
        }

        @if (Model.Page < Model.TotalPages)
        {
            <a asp-controller="Audit"
               asp-action="Index"
               asp-route-schoolId="@Model.Query.SchoolId"
               asp-route-auditAction="@Model.Query.Action"
               asp-route-entityType="@Model.Query.EntityType"
               asp-route-correlationId="@Model.Query.CorrelationId"
               asp-route-actorUserId="@Model.Query.ActorUserId"
               asp-route-actorRole="@Model.Query.ActorRole"
               asp-route-fromUtc="@Model.Query.FromUtc"
               asp-route-toUtc="@Model.Query.ToUtc"
               asp-route-page="@(Model.Page + 1)"
               asp-route-pageSize="@Model.PageSize"
               class="btn btn-outline-secondary">
                @T["Next"]
            </a>
        }
    </div>
</div>
