@inject Microsoft.Extensions.Localization.IStringLocalizer<Edulytics.Web.PlatformResource> T

@{
    Layout = "_AuthLayout";
    ViewData["Title"] = T["PasswordSetTitle"].Value;
}

<section class="auth-card user-password-card">
    <div class="auth-heading">
        <h1>@T["PasswordSetTitle"]</h1>
        <p>@T["PasswordSetSuccess"]</p>
    </div>

    <a class="auth-primary-button user-login-link"
       asp-controller="Account"
       asp-action="Login">
        @T["GoToLogin"]
    </a>
</section>
