@model Edulytics.Web.ViewModels.SetPasswordViewModel
@inject Microsoft.Extensions.Localization.IStringLocalizer<Edulytics.Web.PlatformResource> T

@{
    Layout = "_AuthLayout";
    ViewData["Title"] = T["PasswordSetupTitle"].Value;
}

<section class="auth-card user-password-card">
    <div class="auth-heading">
        <h1>@T["PasswordSetupTitle"]</h1>
        <p>@T["PasswordSetupIntro"]</p>
    </div>

    <form method="post"
          asp-controller="Account"
          asp-action="SetPassword"
          asp-antiforgery="false">

        <input asp-for="UserId"
               type="hidden" />

        <input asp-for="Token"
               type="hidden" />

        <input asp-for="Culture"
               type="hidden" />

        <div asp-validation-summary="ModelOnly"
             class="user-validation-summary"
             role="alert">
        </div>

        <div class="auth-field">
            <label asp-for="Password">
                @T["NewPassword"]
            </label>

            <input asp-for="Password"
                   type="password"
                   autocomplete="new-password" />

            <span asp-validation-for="Password"
                  class="user-field-error">
            </span>
        </div>

        <div class="auth-field">
            <label asp-for="ConfirmPassword">
                @T["ConfirmPassword"]
            </label>

            <input asp-for="ConfirmPassword"
                   type="password"
                   autocomplete="new-password" />

            <span asp-validation-for="ConfirmPassword"
                  class="user-field-error">
            </span>
        </div>

        <p class="user-password-policy">
            @T["PasswordPolicyDescription"]
        </p>

        <button type="submit"
                class="auth-primary-button">
            @T["SetPassword"]
        </button>
    </form>
</section>
