@model Edulytics.Web.Presentation.LessonReaderSection

<section class="lesson-learning-section
                lesson-learning-section--@Model.Kind">

    <header class="lesson-learning-section__header">
        <span class="lesson-learning-section__number">
            @Model.Number
        </span>

        <h2>@Model.Title</h2>
    </header>

    @if (Model.Kind == "steps")
    {
        <ol class="lesson-step-list">
            @foreach (var item in Model.Items)
            {
                <li>
                    @if (item.IsVisual)
                    {
                        <partial name="_LessonInstructionalVisual"
                                 model="item" />
                    }
                    else
                    {
                        <div class="lesson-reader-text">
                            @item.Text
                        </div>
                    }
                </li>
            }
        </ol>
    }
    else if (Model.Kind == "summary")
    {
        <div class="lesson-reader-blocks
                    lesson-reader-blocks--summary">

            <ul class="lesson-summary-list">
                @foreach (var item in Model.Items)
                {
                    @if (item.IsVisual)
                    {
                        <li class="lesson-summary-list__visual">
                            <partial name="_LessonInstructionalVisual"
                                     model="item" />
                        </li>
                    }
                    else
                    {
                        <li>
                            @item.Text
                        </li>
                    }
                }
            </ul>
        </div>
    }
    else
    {
        <div class="lesson-reader-blocks
                    lesson-reader-blocks--@Model.Kind">

            @foreach (var item in Model.Items)
            {
                @if (item.IsVisual)
                {
                    <partial name="_LessonInstructionalVisual"
                             model="item" />
                }
                else if (
                    Model.Kind == "examples" &&
                    item.Text is not null &&
                    System.Text.RegularExpressions.Regex.IsMatch(
                        item.Text,
                        @"^Example\s+\d+\s*:?\s*$",
                        System.Text.RegularExpressions.RegexOptions.IgnoreCase))
                {
                    <h3 class="lesson-example-heading">
                        @item.Text.TrimEnd(':')
                    </h3>
                }
                else
                {
                    <p class="lesson-reader-text">
                        @item.Text
                    </p>
                }
            }
        </div>
    }
</section>
