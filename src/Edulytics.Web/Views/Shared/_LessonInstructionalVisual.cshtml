@model Edulytics.Web.Presentation.LessonPresentationItem
@using Edulytics.Web.Presentation
@using System.Globalization

@functions {
    private static string Svg(double value) =>
        value.ToString("0.###", CultureInfo.InvariantCulture);
}

@{
    var visual = Model.Visual
        ?? throw new InvalidOperationException(
            "Instructional visual model is required.");
}

<figure class="lesson-instructional-visual"
        aria-label="@visual.AccessibilityText">

    @if (!string.IsNullOrWhiteSpace(visual.Title))
    {
        <div class="lesson-instructional-visual__title">
            @visual.Title
        </div>
    }

    @if (visual.Type == LessonVisualType.MeasuredPath)
    {
        var xs = new[] { 80d, 235d, 690d };

        <svg viewBox="0 0 760 220"
             role="img"
             aria-label="@visual.AccessibilityText">

            <title>@visual.AccessibilityText</title>

            <line x1="80"
                  y1="105"
                  x2="690"
                  y2="105"
                  class="visual-line" />

            @for (var i = 0; i < 3; i++)
            {
                var x = xs[i];

                <line x1="@Svg(x)"
                      y1="72"
                      x2="@Svg(x)"
                      y2="138"
                      class="visual-mark" />

                <foreignObject x="@Svg(x - 70)"
                               y="145"
                               width="140"
                               height="48">
                    <div xmlns="http://www.w3.org/1999/xhtml"
                         class="visual-svg-label">
                        @visual.Labels[i]
                    </div>
                </foreignObject>
            }

            <foreignObject x="@Svg(((xs[0] + xs[1]) / 2) - 45)"
                           y="38"
                           width="90"
                           height="42">
                <div xmlns="http://www.w3.org/1999/xhtml"
                     class="visual-svg-measure">
                    @visual.Measures[0]
                </div>
            </foreignObject>

            <foreignObject x="@Svg(((xs[1] + xs[2]) / 2) - 45)"
                           y="38"
                           width="90"
                           height="42">
                <div xmlns="http://www.w3.org/1999/xhtml"
                     class="visual-svg-measure">
                    @visual.Measures[1]
                </div>
            </foreignObject>
        </svg>
    }
    else if (visual.Type == LessonVisualType.DoubleNumberLine)
    {
        var tickCount =
            Math.Max(
                2,
                Math.Max(
                    visual.PrimaryValues.Count,
                    visual.SecondaryValues.Count));

        const double left = 190;
        const double right = 700;

        <svg viewBox="0 0 760 280"
             role="img"
             aria-label="@visual.AccessibilityText">

            <title>@visual.AccessibilityText</title>

            <foreignObject x="10"
                           y="52"
                           width="165"
                           height="55">
                <div xmlns="http://www.w3.org/1999/xhtml"
                     class="visual-svg-axis-label">
                    @visual.PrimaryLabel
                </div>
            </foreignObject>

            <foreignObject x="10"
                           y="162"
                           width="165"
                           height="55">
                <div xmlns="http://www.w3.org/1999/xhtml"
                     class="visual-svg-axis-label">
                    @visual.SecondaryLabel
                </div>
            </foreignObject>

            <line x1="@Svg(left)"
                  y1="90"
                  x2="@Svg(right)"
                  y2="90"
                  class="visual-line" />

            <line x1="@Svg(left)"
                  y1="200"
                  x2="@Svg(right)"
                  y2="200"
                  class="visual-line" />

            @for (var i = 0; i < tickCount; i++)
            {
                var x =
                    left +
                    i * ((right - left) / (tickCount - 1));

                var top =
                    i < visual.PrimaryValues.Count
                        ? visual.PrimaryValues[i]
                        : string.Empty;

                var bottom =
                    i < visual.SecondaryValues.Count
                        ? visual.SecondaryValues[i]
                        : string.Empty;

                <line x1="@Svg(x)"
                      y1="74"
                      x2="@Svg(x)"
                      y2="106"
                      class="visual-mark" />

                <line x1="@Svg(x)"
                      y1="184"
                      x2="@Svg(x)"
                      y2="216"
                      class="visual-mark" />

                @if (!string.IsNullOrWhiteSpace(top))
                {
                    <foreignObject x="@Svg(x - 40)"
                                   y="110"
                                   width="80"
                                   height="38">
                        <div xmlns="http://www.w3.org/1999/xhtml"
                             class="visual-svg-value">
                            @top
                        </div>
                    </foreignObject>
                }

                @if (!string.IsNullOrWhiteSpace(bottom))
                {
                    <foreignObject x="@Svg(x - 40)"
                                   y="220"
                                   width="80"
                                   height="38">
                        <div xmlns="http://www.w3.org/1999/xhtml"
                             class="visual-svg-value">
                            @bottom
                        </div>
                    </foreignObject>
                }
            }
        </svg>
    }
    else if (visual.Type == LessonVisualType.NumberLine)
    {
        var count =
            Math.Max(
                2,
                visual.PrimaryValues.Count);

        const double left = 80;
        const double right = 680;

        <svg viewBox="0 0 760 190"
             role="img"
             aria-label="@visual.AccessibilityText">

            <title>@visual.AccessibilityText</title>

            <line x1="@Svg(left)"
                  y1="85"
                  x2="@Svg(right)"
                  y2="85"
                  class="visual-line" />

            @for (var i = 0; i < count; i++)
            {
                var x =
                    left +
                    i * ((right - left) / (count - 1));

                <line x1="@Svg(x)"
                      y1="68"
                      x2="@Svg(x)"
                      y2="103"
                      class="visual-mark" />

                @if (
                    i < visual.PrimaryValues.Count &&
                    !string.IsNullOrWhiteSpace(
                        visual.PrimaryValues[i]))
                {
                    <foreignObject x="@Svg(x - 40)"
                                   y="108"
                                   width="80"
                                   height="40">
                        <div xmlns="http://www.w3.org/1999/xhtml"
                             class="visual-svg-value">
                            @visual.PrimaryValues[i]
                        </div>
                    </foreignObject>
                }
            }
        </svg>
    }
    else if (visual.Type == LessonVisualType.CoordinatePlane)
    {
        <svg viewBox="0 0 580 380"
             role="img"
             aria-label="@visual.AccessibilityText">

            <title>@visual.AccessibilityText</title>

            @for (var i = 0; i <= 8; i++)
            {
                var p = 70 + i * 50;

                <line x1="70"
                      y1="@p"
                      x2="470"
                      y2="@p"
                      class="visual-grid-line" />

                <line x1="@p"
                      y1="40"
                      x2="@p"
                      y2="340"
                      class="visual-grid-line" />
            }

            <line x1="70"
                  y1="290"
                  x2="520"
                  y2="290"
                  class="visual-line" />

            <line x1="270"
                  y1="340"
                  x2="270"
                  y2="25"
                  class="visual-line" />

            <foreignObject x="515"
                           y="288"
                           width="35"
                           height="35">
                <div xmlns="http://www.w3.org/1999/xhtml"
                     class="visual-svg-axis-symbol">
                    x
                </div>
            </foreignObject>

            <foreignObject x="242"
                           y="2"
                           width="35"
                           height="35">
                <div xmlns="http://www.w3.org/1999/xhtml"
                     class="visual-svg-axis-symbol">
                    y
                </div>
            </foreignObject>
        </svg>
    }
    else if (
        visual.Type == LessonVisualType.AreaDecomposition &&
        visual.Variant == "area-four-panels")
    {
        <svg viewBox="0 0 760 310"
             role="img"
             aria-label="@visual.AccessibilityText">

            <title>@visual.AccessibilityText</title>

            <g transform="translate(45 45)">
                <rect x="0"
                      y="0"
                      width="145"
                      height="145"
                      class="visual-area-outline" />

                <line x1="72.5"
                      y1="0"
                      x2="72.5"
                      y2="145"
                      class="visual-area-cut" />

                <line x1="0"
                      y1="72.5"
                      x2="145"
                      y2="72.5"
                      class="visual-area-cut" />
            </g>

            <foreignObject x="95"
                           y="8"
                           width="45"
                           height="34">
                <div xmlns="http://www.w3.org/1999/xhtml"
                     class="visual-svg-panel-label">
                    A
                </div>
            </foreignObject>

            <g transform="translate(220 45)">
                <rect x="0"
                      y="0"
                      width="145"
                      height="145"
                      class="visual-area-outline" />

                <line x1="72.5"
                      y1="0"
                      x2="72.5"
                      y2="145"
                      class="visual-area-cut" />

                <line x1="0"
                      y1="72.5"
                      x2="145"
                      y2="72.5"
                      class="visual-area-cut" />

                <line x1="72.5"
                      y1="36.25"
                      x2="145"
                      y2="36.25"
                      class="visual-area-cut" />

                <line x1="108.75"
                      y1="0"
                      x2="108.75"
                      y2="72.5"
                      class="visual-area-cut" />
            </g>

            <foreignObject x="270"
                           y="8"
                           width="45"
                           height="34">
                <div xmlns="http://www.w3.org/1999/xhtml"
                     class="visual-svg-panel-label">
                    B
                </div>
            </foreignObject>

            <g transform="translate(395 45)">
                <rect x="0"
                      y="0"
                      width="145"
                      height="145"
                      class="visual-area-outline" />

                <rect x="0"
                      y="0"
                      width="96"
                      height="96"
                      class="visual-area-fill" />

                <line x1="48"
                      y1="0"
                      x2="48"
                      y2="96"
                      class="visual-area-cut" />

                <line x1="0"
                      y1="48"
                      x2="96"
                      y2="48"
                      class="visual-area-cut" />
            </g>

            <foreignObject x="445"
                           y="8"
                           width="45"
                           height="34">
                <div xmlns="http://www.w3.org/1999/xhtml"
                     class="visual-svg-panel-label">
                    C
                </div>
            </foreignObject>

            <g transform="translate(570 45)">
                <rect x="0"
                      y="0"
                      width="145"
                      height="145"
                      class="visual-area-outline" />

                @for (var i = 1; i < 4; i++)
                {
                    var p = i * 36.25;

                    <line x1="@Svg(p)"
                          y1="0"
                          x2="@Svg(p)"
                          y2="145"
                          class="visual-area-cut" />

                    <line x1="0"
                          y1="@Svg(p)"
                          x2="145"
                          y2="@Svg(p)"
                          class="visual-area-cut" />
                }
            </g>

            <foreignObject x="620"
                           y="8"
                           width="45"
                           height="34">
                <div xmlns="http://www.w3.org/1999/xhtml"
                     class="visual-svg-panel-label">
                    D
                </div>
            </foreignObject>

            <foreignObject x="170"
                           y="220"
                           width="420"
                           height="55">
                <div xmlns="http://www.w3.org/1999/xhtml"
                     class="visual-svg-concept">
                    Compare equal-sized units before counting area.
                </div>
            </foreignObject>
        </svg>
    }
    else if (
        visual.Type == LessonVisualType.AreaDecomposition &&
        visual.Variant == "area-tangram")
    {
        <svg viewBox="0 0 560 370"
             role="img"
             aria-label="@visual.AccessibilityText">

            <title>@visual.AccessibilityText</title>

            <rect x="110"
                  y="45"
                  width="280"
                  height="280"
                  class="visual-area-outline" />

            <line x1="110"
                  y1="45"
                  x2="390"
                  y2="325"
                  class="visual-area-cut" />

            <line x1="390"
                  y1="45"
                  x2="110"
                  y2="325"
                  class="visual-area-cut" />

            <line x1="250"
                  y1="45"
                  x2="110"
                  y2="185"
                  class="visual-area-cut" />

            <line x1="250"
                  y1="325"
                  x2="390"
                  y2="185"
                  class="visual-area-cut" />

            <line x1="180"
                  y1="255"
                  x2="320"
                  y2="115"
                  class="visual-area-cut" />
        </svg>
    }
    else if (visual.Type == LessonVisualType.AreaDecomposition)
    {
        <svg viewBox="0 0 700 310"
             role="img"
             aria-label="@visual.AccessibilityText">

            <title>@visual.AccessibilityText</title>

            <g transform="translate(50 55)">
                <rect x="0"
                      y="0"
                      width="220"
                      height="160"
                      class="visual-area-fill" />

                <line x1="110"
                      y1="0"
                      x2="110"
                      y2="160"
                      class="visual-area-cut" />

                <line x1="0"
                      y1="80"
                      x2="220"
                      y2="80"
                      class="visual-area-cut" />
            </g>

            <path d="M300 135h70"
                  class="visual-arrow" />

            <g transform="translate(405 55)">
                <rect x="0"
                      y="0"
                      width="220"
                      height="160"
                      class="visual-area-fill" />

                <line x1="55"
                      y1="0"
                      x2="55"
                      y2="160"
                      class="visual-area-cut" />

                <line x1="165"
                      y1="0"
                      x2="165"
                      y2="160"
                      class="visual-area-cut" />
            </g>

            <foreignObject x="160"
                           y="235"
                           width="380"
                           height="45">
                <div xmlns="http://www.w3.org/1999/xhtml"
                     class="visual-svg-concept">
                    Same area — different decomposition
                </div>
            </foreignObject>
        </svg>
    }
    else if (visual.Type == LessonVisualType.ArrayOrGrid)
    {
        <svg viewBox="0 0 500 340"
             role="img"
             aria-label="@visual.AccessibilityText">

            <title>@visual.AccessibilityText</title>

            <rect x="80"
                  y="40"
                  width="320"
                  height="240"
                  class="visual-area-outline" />

            @for (var i = 1; i < 8; i++)
            {
                var x = 80 + i * 40;

                <line x1="@x"
                      y1="40"
                      x2="@x"
                      y2="280"
                      class="visual-grid-line-strong" />
            }

            @for (var i = 1; i < 6; i++)
            {
                var y = 40 + i * 40;

                <line x1="80"
                      y1="@y"
                      x2="400"
                      y2="@y"
                      class="visual-grid-line-strong" />
            }
        </svg>
    }
    else if (visual.Type == LessonVisualType.FractionOrRatioBar)
    {
        <svg viewBox="0 0 680 210"
             role="img"
             aria-label="@visual.AccessibilityText">

            <title>@visual.AccessibilityText</title>

            <rect x="70"
                  y="70"
                  width="540"
                  height="70"
                  class="visual-area-fill" />

            @for (var i = 1; i < 6; i++)
            {
                var x = 70 + i * 90;

                <line x1="@x"
                      y1="70"
                      x2="@x"
                      y2="140"
                      class="visual-area-cut" />
            }
        </svg>
    }
    else if (visual.Type == LessonVisualType.GeometricFigure)
    {
        <svg viewBox="0 0 520 340"
             role="img"
             aria-label="@visual.AccessibilityText">

            <title>@visual.AccessibilityText</title>

            @if (visual.Variant == "triangle")
            {
                <polygon points="260,45 85,285 435,285"
                         class="visual-geometry-shape" />
            }
            else if (visual.Variant == "rectangle")
            {
                <rect x="85"
                      y="75"
                      width="350"
                      height="210"
                      class="visual-geometry-shape" />
            }
            else if (visual.Variant == "quadrilateral")
            {
                <polygon points="115,70 420,95 380,285 75,245"
                         class="visual-geometry-shape" />
            }
            else if (visual.Variant == "polygon")
            {
                <polygon points="260,40 420,125 390,280 130,280 95,125"
                         class="visual-geometry-shape" />
            }
        </svg>
    }

    <figcaption>
        @visual.Caption
    </figcaption>
</figure>
