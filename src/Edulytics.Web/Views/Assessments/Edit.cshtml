@model Edulytics.Web.ViewModels.Assessments.AssessmentEditViewModel
@inject Microsoft.Extensions.Localization.IStringLocalizer<Edulytics.Web.AssessmentResource> A
@{
    ViewData["Title"] = A["EditAssessment"];
    var assessment = Model.Details.Assessment;
}
<section class="assessment-page assessment-edit-page">
    <header class="assessment-header">
        <div>
            <h1>@A["EditAssessment"]</h1>
            <p>@assessment.Title</p>
        </div>
        <a class="school-button"
           asp-action="Details"
           asp-route-id="@assessment.Id">@A["Details"]</a>
    </header>

    @if (TempData["Error"] is string error)
    {
        <div class="school-alert school-alert-error" role="alert">@error</div>
    }

    <section class="assessment-card">
        <form asp-action="Edit" asp-route-id="@assessment.Id"
              method="post" class="assessment-form">
            @Html.AntiForgeryToken()
            <input type="hidden" name="rowVersion"
                   value="@Convert.ToBase64String(assessment.RowVersion)" />

            <label for="title">@A["Title"]</label>
            <input id="title" name="title"
                   value="@assessment.Title" maxlength="200" required />

            <label for="assessmentDate">@A["AssessmentDate"]</label>
            <input id="assessmentDate" name="assessmentDate"
                   type="date"
                   value="@assessment.AssessmentDate.ToString("yyyy-MM-dd")"
                   required />

            <label for="maxScore">@A["MaxScore"]</label>
            <input id="maxScore" name="maxScore"
                   type="number" min="0.01" max="10000" step="0.01"
                   value="@assessment.MaxScore.ToString(System.Globalization.CultureInfo.InvariantCulture)"
                   required />

            <button type="submit"
                    class="school-button school-button-primary">@A["SaveChanges"]</button>
        </form>
    </section>
</section>
