@using Edulytics.Core.Constants
@model Edulytics.Web.ViewModels.Assessments.AssessmentDetailsViewModel
@inject Microsoft.Extensions.Localization.IStringLocalizer<Edulytics.Web.AssessmentResource> A
@{
    var canManageAssessment = User.IsInRole(RoleNames.Teacher);
}

@{
    ViewData["Title"] = A["Assessment"];
    var assessment = Model.Details.Assessment;
    var rowVersion = Convert.ToBase64String(assessment.RowVersion);
}

<section class="assessment-page @(canManageAssessment ? "" : "is-readonly")">
    <header class="assessment-header">
        <div>
            <span class="assessment-context">
                @Model.SubjectName · @Model.ClassName · @Model.TermName
            </span>
            <h1>@assessment.Title</h1>
            <p>
                @assessment.AssessmentDate.ToString("yyyy-MM-dd")
                · @A["MaxScore"]: @assessment.MaxScore.ToString("0.##")
                · @A["Status"]: @A[Model.StatusKey]
            </p>
        </div>

        <div class="assessment-actions">
            <a class="school-button"
               asp-action="Index">@A["Assessments"]</a>

            @if (assessment.Status == Edulytics.Core.Enums.AssessmentStatus.Draft)
            {
                @if (canManageAssessment)
                {
                    <a class="school-button"
                                       asp-action="Edit"
                                       asp-route-id="@assessment.Id">
                                        @A["EditAssessment"]
                                    </a>
                }

                @if (canManageAssessment)
                {
                    <form asp-action="DeleteAssessment"
                                          asp-route-id="@assessment.Id"
                                          method="post">
                                        @Html.AntiForgeryToken()

                                        <input type="hidden"
                                               name="rowVersion"
                                               value="@rowVersion" />

                                        <button type="submit"
                                                class="school-button">
                                            @A["DeleteAssessment"]
                                        </button>
                                    </form>
                }
            }

            @if (assessment.Status != Edulytics.Core.Enums.AssessmentStatus.Draft)
            {
                <a class="school-button school-button-primary"
                   asp-action="Results"
                   asp-route-id="@assessment.Id">
                    @A["Results"]
                </a>
            }
        </div>
    </header>

    @if (TempData["Success"] is string success)
    {
        <div class="school-alert school-alert-success"
             role="status">@success</div>
    }

    @if (TempData["Error"] is string error)
    {
        <div class="school-alert school-alert-error"
             role="alert">@error</div>
    }

    @if (assessment.Status == Edulytics.Core.Enums.AssessmentStatus.Draft)
    {
        @if (canManageAssessment)
        {
            <div class="assessment-info">@A["DraftHelp"]</div>
            <div class="assessment-info">@A["DefinitionRule"]</div>
        }
        else
        {
            <div class="assessment-info">@A["AssessmentMonitorNotice"]</div>
        }

        <section class="assessment-card assessment-operational-create">
            <h2>@A["CreateQuestion"]</h2>

            @if (canManageAssessment)
            {
                <form asp-action="CreateQuestion"
                                  asp-route-id="@assessment.Id"
                                  method="post"
                                  class="assessment-form assessment-question-create-form">

                                @Html.AntiForgeryToken()

                                <input type="hidden"
                                       name="rowVersion"
                                       value="@rowVersion" />

                                <label for="prompt">
                                    @A["QuestionPrompt"]
                                </label>

                                <textarea id="prompt"
                                          name="prompt"
                                          maxlength="1000"
                                          rows="3"
                                          required></textarea>

                                <label for="questionMaxScore">
                                    @A["QuestionMaxScore"]
                                </label>

                                <input id="questionMaxScore"
                                       name="maxScore"
                                       type="number"
                                       min="0.01"
                                       max="10000"
                                       step="0.01"
                                       required />

                                <label for="order">
                                    @A["Order"]
                                </label>

                                <input id="order"
                                       name="order"
                                       type="number"
                                       min="1"
                                       required />

                                <fieldset>
                                    <legend>
                                        @A["LearningOutcomes"]
                                    </legend>

                                    <p>
                                        @A["SelectOneOrMoreOutcomes"]
                                    </p>

                                    @if (Model.Details.EligibleOutcomes.Count == 0)
                                    {
                                        <p>@A["NoEligibleOutcomes"]</p>
                                    }
                                    else
                                    {
                                        @foreach (var outcome in Model.Details.EligibleOutcomes)
                                        {
                                            <label>
                                                <input type="checkbox"
                                                       name="outcomeIds"
                                                       value="@outcome.Id" />

                                                <strong>
                                                    @outcome.Code
                                                </strong>
                                                — @outcome.Description
                                            </label>
                                        }
                                    }
                                </fieldset>

                                @if (Model.Details.EligibleOutcomes.Count > 0)
                                {
                                    <button type="submit"
                                            class="school-button school-button-primary">
                                        @A["Create"]
                                    </button>
                                }
                            </form>
            }
        </section>
    }
    else if (assessment.Status == Edulytics.Core.Enums.AssessmentStatus.Open)
    {
        <div class="assessment-info">
            @A["OpenHelp"]
        </div>
    }

    <section class="assessment-question-list">
        <h2>@A["Questions"]</h2>

        @if (Model.Details.Questions.Count == 0)
        {
            <div class="assessment-empty">
                @A["NoQuestions"]
            </div>
        }
        else
        {
            @foreach (var question in Model.Details.Questions)
            {
                <article class="assessment-question-card">
                    <header>
                        <div>
                            <h3>
                                @question.Order. @question.Prompt
                            </h3>

                            <p>
                                @A["QuestionMaxScore"]:
                                @question.MaxScore.ToString("0.##")
                            </p>
                        </div>

                        @if (assessment.Status == Edulytics.Core.Enums.AssessmentStatus.Draft)
                        {
                            <div class="assessment-actions">
                                @if (canManageAssessment)
                                {
                                    <a class="school-button"
                                                                       asp-action="EditQuestion"
                                                                       asp-route-questionId="@question.Id"
                                                                       asp-route-assessmentId="@assessment.Id">
                                                                        @A["Edit"]
                                                                    </a>
                                }

                                @if (canManageAssessment)
                                {
                                    <form asp-action="DeleteQuestion"
                                                                          asp-route-questionId="@question.Id"
                                                                          method="post">

                                                                        @Html.AntiForgeryToken()

                                                                        <input type="hidden"
                                                                               name="assessmentId"
                                                                               value="@assessment.Id" />

                                                                        <input type="hidden"
                                                                               name="rowVersion"
                                                                               value="@rowVersion" />

                                                                        <button type="submit"
                                                                                class="school-button">
                                                                            @A["DeleteQuestion"]
                                                                        </button>
                                                                    </form>
                                }
                            </div>
                        }
                    </header>

                    <div class="assessment-mappings">
                        <h4>
                            @A["OutcomeMappings"]
                        </h4>

                        @if (question.OutcomeIds.Count == 0)
                        {
                            <p>
                                @A["NoMappings"]
                            </p>
                        }
                        else
                        {
                            <div class="assessment-mapping-tags">
                                @foreach (var outcomeId in question.OutcomeIds)
                                {
                                    var outcome =
                                        Model.Outcome(outcomeId);

                                    if (outcome is not null)
                                    {
                                        <div class="assessment-mapping-tag">
                                            <span>
                                                <strong>
                                                    @outcome.Code
                                                </strong>
                                                — @outcome.Description
                                            </span>
                                        </div>
                                    }
                                }
                            </div>
                        }
                    </div>
                </article>
            }
        }
    </section>

    <section class="assessment-lifecycle">
        @if (assessment.Status == Edulytics.Core.Enums.AssessmentStatus.Draft)
        {
            @if (canManageAssessment)
            {
                <form asp-action="Open"
                                  asp-route-id="@assessment.Id"
                                  method="post">

                                @Html.AntiForgeryToken()

                                <input type="hidden"
                                       name="rowVersion"
                                       value="@rowVersion" />

                                <button type="submit"
                                        class="school-button school-button-primary">
                                    @A["OpenAssessment"]
                                </button>
                            </form>
            }
        }
        else if (assessment.Status == Edulytics.Core.Enums.AssessmentStatus.Open)
        {
            @if (canManageAssessment)
            {
                <form asp-action="Close"
                                  asp-route-id="@assessment.Id"
                                  method="post">

                                @Html.AntiForgeryToken()

                                <input type="hidden"
                                       name="rowVersion"
                                       value="@rowVersion" />

                                <button type="submit"
                                        class="school-button">
                                    @A["CloseAssessment"]
                                </button>
                            </form>
            }
        }
    </section>
</section>
