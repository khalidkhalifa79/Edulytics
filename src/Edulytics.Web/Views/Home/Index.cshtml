@{
    Layout = "_PublicLayout";
}

<section class="language-shell">
    <div class="language-brand"
         aria-label="Edulytics">
    <partial name="_LocalizedBrand" />
</div>
    </div>

    <div class="language-grid">
        <form asp-controller="Home"
              asp-action="SetCulture"
              method="post"
              class="language-form">
            @Html.AntiForgeryToken()
            <input type="hidden"
                   name="culture"
                   value="pl" />
            <button type="submit"
                    class="language-card"
                    aria-label="Polski">
                <span class="language-code"
                      aria-hidden="true">PL</span>
                <span>Polski</span>
            </button>
        </form>

        <form asp-controller="Home"
              asp-action="SetCulture"
              method="post"
              class="language-form">
            @Html.AntiForgeryToken()
            <input type="hidden"
                   name="culture"
                   value="en" />
            <button type="submit"
                    class="language-card"
                    aria-label="English">
                <span class="language-code"
                      aria-hidden="true">EN</span>
                <span>English</span>
            </button>
        </form>
    </div>
</section>
