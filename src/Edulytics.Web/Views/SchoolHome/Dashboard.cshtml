@using Edulytics.Core.Constants
@model Edulytics.Web.ViewModels.SchoolUsers.SchoolHomeViewModel
@inject Microsoft.Extensions.Localization.IStringLocalizer<Edulytics.Web.PlatformResource> T
@inject Microsoft.Extensions.Localization.IStringLocalizer<Edulytics.Web.AcademicResource> A
@inject Microsoft.Extensions.Localization.IStringLocalizer<Edulytics.Web.CurriculumResource> C
@inject Microsoft.Extensions.Localization.IStringLocalizer<Edulytics.Web.AssessmentResource> S
@inject Microsoft.Extensions.Localization.IStringLocalizer<Edulytics.Web.AnalyticsResource> N
@inject Microsoft.Extensions.Localization.IStringLocalizer<Edulytics.Web.ImportResource> D
@inject Microsoft.Extensions.Localization.IStringLocalizer<Edulytics.Web.ReportResource> R
@inject Microsoft.Extensions.Localization.IStringLocalizer<Edulytics.Web.NotificationResource> Q

@{
    ViewData["Title"] = T["SchoolDashboardTitle"].Value;

    var isAdmin = Model.Role == RoleNames.SchoolAdmin;
    var isSupervisor = Model.Role == RoleNames.SubjectSupervisor;
    var isTeacher = Model.Role == RoleNames.Teacher;

    var roleAccessKey = isSupervisor
        ? "AccessManage"
        : isTeacher
            ? "AccessTeach"
            : "AccessMonitor";
}

<section class="user-page ed-dashboard">
    <header class="ed-dashboard-hero"
            aria-label="@T["AccountReady"]">
        <div class="ed-dashboard-hero-copy">
            <div class="user-eyebrow">
                @T["YourSchool"]
            </div>

            <h1>@Model.SchoolName</h1>

            <p class="user-page-subtitle">
                @T["SchoolDashboardSubtitle"]
            </p>
        </div>

        <div class="ed-dashboard-identity">
            <span class="ed-dashboard-identity-label">
                @T["YourRole"]
            </span>

            <strong>
                @T[$"Role{Model.Role}"]
            </strong>

            <span class="ed-access-pill"
                  data-access="@roleAccessKey">
                @T[roleAccessKey]
            </span>
        </div>
    </header>

    <div class="ed-dashboard-grid">
        @if (isAdmin || isSupervisor)
        {
            <article class="user-dashboard-action ed-module-card"
                     data-tone="blue">
                <div>
                    <div class="ed-module-meta">
                        <span class="ed-access-pill"
                              data-access="@(isSupervisor ? "AccessManage" : "AccessView")">
                            @(isSupervisor
                                ? T["AccessManage"]
                                : T["AccessView"])
                        </span>
                    </div>

                    <h2>@T["SchoolUsersTitle"]</h2>

                    <p>
                        @(isSupervisor
                            ? T["DashboardSchoolUsersSupervisorDescription"]
                            : T["DashboardSchoolUsersAdminDescription"])
                    </p>
                </div>

                <a class="school-button @(isSupervisor ? "school-button-primary" : "school-button-secondary")"
                   asp-controller="SchoolUsers"
                   asp-action="Index">
                    @(isSupervisor
                        ? T["ManageUsersOperational"]
                        : T["ViewUsers"])
                </a>
            </article>
        }

        @if (isAdmin)
        {
            <article class="user-dashboard-action ed-module-card"
                     data-tone="violet">
                <div>
                    <div class="ed-module-meta">
                        <span class="ed-access-pill"
                              data-access="AccessManage">
                            @T["AccessManage"]
                        </span>
                    </div>

                    <h2>@T["SubjectSupervisorAssignmentsTitle"]</h2>

                    <p>@T["DashboardSupervisorAssignmentsDescription"]</p>
                </div>

                <a class="school-button school-button-primary"
                   asp-controller="SubjectSupervisorAssignments"
                   asp-action="Index">
                    @T["ManageSupervisors"]
                </a>
            </article>
        }

        @if (isAdmin || isSupervisor || isTeacher)
        {
            <article class="user-dashboard-action ed-module-card"
                     data-tone="cyan">
                <div>
                    <div class="ed-module-meta">
                        <span class="ed-access-pill"
                              data-access="@(isSupervisor ? "AccessManage" : "AccessView")">
                            @(isSupervisor
                                ? T["AccessManage"]
                                : T["AccessView"])
                        </span>
                    </div>

                    <h2>@A["AcademicStructureTitle"]</h2>

                    <p>
                        @(isSupervisor
                            ? T["DashboardAcademicManageDescription"]
                            : T["DashboardAcademicViewDescription"])
                    </p>
                </div>

                <a class="school-button @(isSupervisor ? "school-button-primary" : "school-button-secondary")"
                   asp-controller="AcademicStructure"
                   asp-action="Index">
                    @(isSupervisor
                        ? T["ManageStructure"]
                        : T["ViewStructure"])
                </a>
            </article>

            <article class="user-dashboard-action ed-module-card"
                     data-tone="teal">
                <div>
                    <div class="ed-module-meta">
                        <span class="ed-access-pill"
                              data-access="@(isSupervisor ? "AccessManage" : "AccessView")">
                            @(isSupervisor
                                ? T["AccessManage"]
                                : T["AccessView"])
                        </span>
                    </div>

                    <h2>@C["CurriculumTitle"]</h2>

                    <p>
                        @(isSupervisor
                            ? T["DashboardCurriculumManageDescription"]
                            : T["DashboardCurriculumViewDescription"])
                    </p>
                </div>

                <a class="school-button @(isSupervisor ? "school-button-primary" : "school-button-secondary")"
                   asp-controller="Curriculum"
                   asp-action="Index">
                    @(isSupervisor
                        ? T["ManageCurriculumLink"]
                        : T["ViewCurriculum"])
                </a>
            </article>

            <article class="user-dashboard-action ed-module-card"
                     data-tone="orange">
                <div>
                    <div class="ed-module-meta">
                        <span class="ed-access-pill"
                              data-access="@(isTeacher ? "AccessTeach" : "AccessMonitor")">
                            @(isTeacher
                                ? T["AccessTeach"]
                                : T["AccessMonitor"])
                        </span>
                    </div>

                    <h2>@S["AssessmentTitle"]</h2>

                    <p>
                        @(isTeacher
                            ? T["DashboardAssessmentTeacherDescription"]
                            : T["DashboardAssessmentMonitorDescription"])
                    </p>
                </div>

                <a class="school-button @(isTeacher ? "school-button-primary" : "school-button-secondary")"
                   asp-controller="Assessments"
                   asp-action="Index">
                    @(isTeacher
                        ? T["ManageAssessmentsLink"]
                        : T["MonitorAssessments"])
                </a>
            </article>
        }

        @if (Model.CanViewAnalytics)
        {
            <article class="user-dashboard-action ed-module-card"
                     data-tone="indigo">
                <div>
                    <div class="ed-module-meta">
                        <span class="ed-access-pill"
                              data-access="AccessView">
                            @T["AccessView"]
                        </span>
                    </div>

                    <h2>@N["AnalyticsTitle"]</h2>

                    <p>@T["DashboardAnalyticsDescription"]</p>
                </div>

                <a class="school-button school-button-secondary"
                   asp-controller="Analytics"
                   asp-action="Index">
                    @T["ViewAnalytics"]
                </a>
            </article>

            @if (Model.CanViewReports)
            {
                <article class="user-dashboard-action ed-module-card"
                         data-tone="rose">
                    <div>
                        <div class="ed-module-meta">
                            <span class="ed-access-pill"
                                  data-access="@(isAdmin ? "AccessView" : isTeacher ? "AccessExportOwn" : "AccessExport")">
                                @(isAdmin
                                    ? T["AccessView"]
                                    : isTeacher
                                        ? T["AccessExportOwn"]
                                        : T["AccessExport"])
                            </span>
                        </div>

                        <h2>@R["DashboardReportsTitle"]</h2>

                        <p>
                            @(isAdmin
                                ? T["DashboardReportsViewDescription"]
                                : isTeacher
                                    ? T["DashboardReportsTeacherDescription"]
                                    : T["DashboardReportsManageDescription"])
                        </p>
                    </div>

                    <a class="school-button @(isAdmin ? "school-button-secondary" : "school-button-primary")"
                       asp-controller="Reports"
                       asp-action="Index">
                        @(isAdmin
                            ? T["ViewReports"]
                            : isTeacher
                                ? T["ExportOwnScope"]
                                : T["ManageReportsLink"])
                    </a>
                </article>
            }
        }

        @if (isAdmin || isSupervisor)
        {
            <article class="user-dashboard-action ed-module-card"
                     data-tone="slate">
                <div>
                    <div class="ed-module-meta">
                        <span class="ed-access-pill"
                              data-access="@(isSupervisor ? "AccessManage" : "AccessView")">
                            @(isSupervisor
                                ? T["AccessManage"]
                                : T["AccessView"])
                        </span>
                    </div>

                    <h2>@D["DashboardImportTitle"]</h2>

                    <p>
                        @(isSupervisor
                            ? T["DashboardImportsManageDescription"]
                            : T["DashboardImportsViewDescription"])
                    </p>
                </div>

                <a class="school-button @(isSupervisor ? "school-button-primary" : "school-button-secondary")"
                   asp-controller="Imports"
                   asp-action="Index">
                    @(isSupervisor
                        ? T["ManageImportsLink"]
                        : T["ViewImportHistory"])
                </a>
            </article>
        }

        <article class="user-dashboard-action ed-module-card"
                 data-tone="green">
            <div>
                <div class="ed-module-meta">
                    <span class="ed-access-pill"
                          data-access="AccessView">
                        @T["AccessView"]
                    </span>
                </div>

                <h2>@Q["DashboardNotificationsTitle"]</h2>

                <p>@T["DashboardNotificationsDescription"]</p>
            </div>

            <a class="school-button school-button-secondary"
               asp-controller="Notifications"
               asp-action="Index">
                @T["OpenNotificationsLink"]
            </a>
        </article>
    </div>
</section>
