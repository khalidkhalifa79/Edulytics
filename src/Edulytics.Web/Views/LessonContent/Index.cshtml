@model Edulytics.Web.ViewModels.LessonContent.LessonContentIndexViewModel
@inject Microsoft.Extensions.Localization.IStringLocalizer<Edulytics.Web.LessonContentResource> L
@using Edulytics.Core.Enums
@{ Layout="_AppLayout"; ViewData["Title"]=L["PageTitle"].Value; }

<header class="ed-v3-page-header lesson-content-header"><div>
<p class="ed-v3-eyebrow">@L["CanonicalLibrary"]</p><h1>@L["PageTitle"]</h1><p>@L["PageSubtitle"]</p>
</div></header>
<div class="lesson-content-notice">@L["CanonicalNotice"]</div>

@if(Model.Dashboard.Curricula.Count==0){<div class="lesson-content-empty">@L["NoAdoptedCurricula"]</div>}
else{
<div class="lesson-content-topic-stack">
@foreach(var group in Model.Dashboard.Curricula){
<section class="lesson-content-topic-card">
<header class="lesson-content-topic-card__header"><div>
<span class="student-subject-code">@group.SubjectCode</span><h2>@group.FrameworkName</h2>
<div class="lesson-content-meta">
<span>@L["Grade"]: <strong>@group.GradeName</strong></span>
<span>@L["Version"]: <strong>@group.FrameworkVersionName</strong></span>
<span>@L["Coverage"]: <strong>@group.ProductionReadyLessons / @group.TotalLessons</strong></span>
</div></div>
<span class="lesson-content-coverage-badge">@group.ProductionReadyLessons / @group.TotalLessons @L["ProductionReady"]</span>
</header>
@if(group.Lessons.Count==0){<p class="lesson-content-empty">@L["NoCanonicalLessons"]</p>}
else{
<div class="lesson-content-list">
@foreach(var lesson in group.Lessons){
var statusText=lesson.Status switch{
CanonicalLessonContentStatus.Draft=>L["InPreparation"].Value,
CanonicalLessonContentStatus.Verified=>L["Verified"].Value,
CanonicalLessonContentStatus.Published=>L["ProductionReady"].Value,
_=>L["NotStarted"].Value};
var statusClass=lesson.Status switch{
CanonicalLessonContentStatus.Draft=>"draft",
CanonicalLessonContentStatus.Verified=>"verified",
CanonicalLessonContentStatus.Published=>"published",
_=>"notstarted"};
<a class="lesson-content-row" asp-controller="LessonContent" asp-action="Detail" asp-route-id="@lesson.LessonId">
<span class="lesson-content-row__order">@lesson.SortOrder</span>
<span class="lesson-content-row__title">@lesson.LessonTitle
@if(!string.IsNullOrWhiteSpace(lesson.UnitTitle)){<small>@lesson.UnitTitle</small>}
</span>
<span class="lesson-content-status lesson-content-status--@statusClass">@statusText</span></a>
}
</div>}
</section>}
</div>}
