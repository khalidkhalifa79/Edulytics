@model Edulytics.Web.ViewModels.LessonContent.LessonContentEditorViewModel
@inject Microsoft.Extensions.Localization.IStringLocalizer<Edulytics.Web.LessonContentResource> L
@using Edulytics.Core.Enums
@{
    Layout = "_AppLayout";
    ViewData["Title"] = Model.IsNew ? L["AddLesson"].Value : Model.EnglishTitle;
    var editable = Model.CanAuthor && Model.Status == LearningLessonStatus.Draft;
    var statusText = Model.Status switch
    {
        LearningLessonStatus.Draft => L["DraftStatus"].Value,
        LearningLessonStatus.InReview => L["InReviewStatus"].Value,
        _ => L["PublishedStatus"].Value
    };
}

<header class="ed-v3-page-header lesson-content-header">
    <div>
        <p class="ed-v3-eyebrow">@L["PageTitle"]</p>
        <h1>@(Model.IsNew ? L["AddLesson"] : Model.EnglishTitle)</h1>
        <div class="lesson-content-meta">
            <span>@L["Subject"]: <strong>@Model.SubjectName</strong></span>
            <span>@L["Grade"]: <strong>@Model.GradeName</strong></span>
            <span>@L["Topic"]: <strong>@Model.TopicName</strong></span>
            <span>@L["Status"]: <strong>@statusText</strong></span>
        </div>
    </div>
    <a class="btn btn-secondary" asp-action="Index">@L["BackToLessons"]</a>
</header>

@if (TempData["LessonContentMessage"] is string message)
{
    <div class="lesson-content-message" role="status">@message</div>
}
@if (TempData["LessonContentError"] is string error)
{
    <div class="lesson-content-error" role="alert">@error</div>
}

@if (!editable && !Model.IsNew)
{
    <div class="lesson-content-notice">@L["ReadOnlyNotice"]</div>
}

<form method="post" class="lesson-content-editor">
    @Html.AntiForgeryToken()
    <input type="hidden" asp-for="TopicId" />
    <input type="hidden" asp-for="LessonId" />
    <div asp-validation-summary="All" class="text-danger"></div>

    <section class="lesson-content-panel">
        <h2>@L["Outcomes"]</h2>
        <div class="lesson-content-field lesson-content-field--small">
            <label asp-for="Order">@L["Order"]</label>
            @if (editable)
            {
                <input asp-for="Order" type="number" min="1" />
            }
            else
            {
                <div class="lesson-content-readonly">@Model.Order</div>
            }
        </div>

        <div class="lesson-content-outcomes">
            @foreach (var outcome in Model.AvailableOutcomes)
            {
                var checkedOutcome = Model.OutcomeIds.Contains(outcome.Id);
                if (editable || checkedOutcome)
                {
                    <label class="lesson-content-outcome">
                        @if (editable)
                        {
                            <input type="checkbox" name="OutcomeIds" value="@outcome.Id" checked="@checkedOutcome" />
                        }
                        else
                        {
                            <input type="checkbox" checked disabled />
                        }
                        <span><strong>@outcome.Code</strong> — @outcome.Description</span>
                    </label>
                }
            }
        </div>
    </section>

    <section class="lesson-content-panel">
        <h2>@L["EnglishContent"]</h2>
        <div class="lesson-content-grid">
            <div class="lesson-content-field lesson-content-field--full">
                <label asp-for="EnglishTitle">@L["LessonTitle"]</label>
                <input asp-for="EnglishTitle" readonly="@(!editable)" />
            </div>
            <div class="lesson-content-field lesson-content-field--full">
                <label asp-for="EnglishExplanation">@L["Explanation"]</label>
                <textarea asp-for="EnglishExplanation" rows="6" readonly="@(!editable)"></textarea>
            </div>
            <div class="lesson-content-field">
                <label asp-for="EnglishKeyConceptsAndRules">@L["KeyConceptsAndRules"]</label>
                <textarea asp-for="EnglishKeyConceptsAndRules" rows="6" readonly="@(!editable)"></textarea>
            </div>
            <div class="lesson-content-field">
                <label asp-for="EnglishWorkedExamples">@L["WorkedExamples"]</label>
                <textarea asp-for="EnglishWorkedExamples" rows="6" readonly="@(!editable)"></textarea>
            </div>
            <div class="lesson-content-field">
                <label asp-for="EnglishStepByStepSolutions">@L["StepByStepSolutions"]</label>
                <textarea asp-for="EnglishStepByStepSolutions" rows="6" readonly="@(!editable)"></textarea>
            </div>
            <div class="lesson-content-field">
                <label asp-for="EnglishCommonMistakes">@L["CommonMistakes"]</label>
                <textarea asp-for="EnglishCommonMistakes" rows="6" readonly="@(!editable)"></textarea>
            </div>
            <div class="lesson-content-field lesson-content-field--full">
                <label asp-for="EnglishQuickSummary">@L["QuickSummary"]</label>
                <textarea asp-for="EnglishQuickSummary" rows="4" readonly="@(!editable)"></textarea>
            </div>
        </div>
    </section>

    <section class="lesson-content-panel">
        <h2>@L["PolishContent"]</h2>
        <div class="lesson-content-grid">
            <div class="lesson-content-field lesson-content-field--full">
                <label asp-for="PolishTitle">@L["LessonTitle"]</label>
                <input asp-for="PolishTitle" readonly="@(!editable)" />
            </div>
            <div class="lesson-content-field lesson-content-field--full">
                <label asp-for="PolishExplanation">@L["Explanation"]</label>
                <textarea asp-for="PolishExplanation" rows="6" readonly="@(!editable)"></textarea>
            </div>
            <div class="lesson-content-field">
                <label asp-for="PolishKeyConceptsAndRules">@L["KeyConceptsAndRules"]</label>
                <textarea asp-for="PolishKeyConceptsAndRules" rows="6" readonly="@(!editable)"></textarea>
            </div>
            <div class="lesson-content-field">
                <label asp-for="PolishWorkedExamples">@L["WorkedExamples"]</label>
                <textarea asp-for="PolishWorkedExamples" rows="6" readonly="@(!editable)"></textarea>
            </div>
            <div class="lesson-content-field">
                <label asp-for="PolishStepByStepSolutions">@L["StepByStepSolutions"]</label>
                <textarea asp-for="PolishStepByStepSolutions" rows="6" readonly="@(!editable)"></textarea>
            </div>
            <div class="lesson-content-field">
                <label asp-for="PolishCommonMistakes">@L["CommonMistakes"]</label>
                <textarea asp-for="PolishCommonMistakes" rows="6" readonly="@(!editable)"></textarea>
            </div>
            <div class="lesson-content-field lesson-content-field--full">
                <label asp-for="PolishQuickSummary">@L["QuickSummary"]</label>
                <textarea asp-for="PolishQuickSummary" rows="4" readonly="@(!editable)"></textarea>
            </div>
        </div>
    </section>

    @if (editable)
    {
        <div class="lesson-content-actions">
            <button class="btn btn-primary" type="submit">@L["SaveDraft"]</button>
        </div>
    }
</form>

@if (Model.CanAuthor && !Model.IsNew && Model.LessonId.HasValue)
{
    <div class="lesson-content-workflow-actions">
        @if (Model.Status == LearningLessonStatus.Draft)
        {
            <form method="post" asp-action="Submit" asp-route-id="@Model.LessonId">
                @Html.AntiForgeryToken()
                <button class="btn btn-primary" type="submit">@L["SubmitForReview"]</button>
            </form>
        }
        else if (Model.Status == LearningLessonStatus.InReview)
        {
            <form method="post" asp-action="ReturnDraft" asp-route-id="@Model.LessonId">
                @Html.AntiForgeryToken()
                <button class="btn btn-secondary" type="submit">@L["ReturnToDraft"]</button>
            </form>
            <form method="post" asp-action="Publish" asp-route-id="@Model.LessonId">
                @Html.AntiForgeryToken()
                <button class="btn btn-primary" type="submit">@L["Publish"]</button>
            </form>
        }
    </div>
}
