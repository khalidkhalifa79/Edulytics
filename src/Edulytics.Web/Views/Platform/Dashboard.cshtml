@* PHASE04_SCHOOL_MANAGEMENT *@
@inject Microsoft.Extensions.Localization.IStringLocalizer<Edulytics.Web.PlatformResource> SchoolText
@inject IStringLocalizer<Edulytics.Web.PlatformResource> Text
@inject IStringLocalizer<Edulytics.Web.OperationsResource> OperationsText
@inject IStringLocalizer<Edulytics.Web.OnboardingResource> OnboardingText

@{
    ViewData["Title"] = Text["DashboardTitle"];
}

<section class="dashboard-shell">
    <div class="dashboard-hero">
        <div>
            <span class="dashboard-eyebrow">
                @Text["PlatformContext"]
            </span>

            <h1>@Text["DashboardTitle"]</h1>

            <p>@Text["DashboardMessage"]</p>
        </div>

        <div class="dashboard-user-card">
            <span class="dashboard-user-label">
                @Text["SignedInAs"]
            </span>

            <strong>@User.Identity?.Name</strong>
        </div>
    </div>
</section>


<section class="school-dashboard-card">
    <div>
        <p class="school-eyebrow">Edulytics</p>
        <h2>@SchoolText["DashboardSchoolsTitle"]</h2>
        <p>@SchoolText["DashboardSchoolsDescription"]</p>
    </div>

    <a class="school-button school-button-primary"
       asp-controller="Schools"
       asp-action="Index">
        @SchoolText["ManageSchools"]
    </a>
</section>


<section class="school-dashboard-card">
    <div>
        <p class="school-eyebrow">@OnboardingText["Eyebrow"]</p>
        <h2>@OnboardingText["DashboardTitle"]</h2>
        <p>@OnboardingText["DashboardDescription"]</p>
    </div>
    <a class="school-button school-button-primary" asp-controller="CustomerOnboarding" asp-action="Index">@OnboardingText["ManageOnboarding"]</a>
</section>


<section class="school-dashboard-card">
    <div>
        <p class="school-eyebrow">Edulytics</p>
        <h2>@OperationsText["DashboardOperationsTitle"]</h2>
        <p>@OperationsText["DashboardOperationsDescription"]</p>
    </div>

    <a class="school-button school-button-primary"
       asp-controller="Operations"
       asp-action="Index">
        @OperationsText["OpenOperations"]
    </a>
</section>
