@model Edulytics.Web.ViewModels.Onboarding.RequestDemoViewModel
@inject IStringLocalizer<Edulytics.Web.OnboardingResource> T

@{
    Layout = "_PublicLayout";
    ViewData["Title"] = T["RequestDemoTitle"];
}

<section class="onboarding-public-shell onboarding-request-demo">
    <div class="onboarding-public-card">
        <header class="onboarding-public-header">
            <div class="onboarding-brand-wrap">
                <partial name="_LocalizedBrand" />
            </div>

            <partial name="_PublicLanguageSwitcher" />
        </header>

        <div class="onboarding-public-copy">
            <p class="onboarding-eyebrow">@T["Eyebrow"]</p>
            <h1>@T["RequestDemoTitle"]</h1>
            <p class="onboarding-intro">@T["RequestDemoIntro"]</p>

            <div class="onboarding-seat-note">
                <span class="onboarding-seat-note-icon"
                      aria-hidden="true">500+</span>
                <span>@T["MinimumSeatsHint"]</span>
            </div>
        </div>

        <form method="post"
              asp-controller="Onboarding"
              asp-action="Index"
              class="onboarding-form onboarding-request-form">
            <div asp-validation-summary="ModelOnly"
                 class="text-danger onboarding-full"></div>

            <label class="onboarding-field">
                <span>@T["SchoolName"]</span>
                <input asp-for="SchoolName"
                       autocomplete="organization" />
                <span asp-validation-for="SchoolName"
                      class="text-danger"></span>
            </label>

            <label class="onboarding-field">
                <span>@T["ContactName"]</span>
                <input asp-for="ContactName"
                       autocomplete="name" />
                <span asp-validation-for="ContactName"
                      class="text-danger"></span>
            </label>

            <label class="onboarding-field">
                <span>@T["WorkEmail"]</span>
                <input asp-for="WorkEmail"
                       type="email"
                       autocomplete="email" />
                <span asp-validation-for="WorkEmail"
                      class="text-danger"></span>
            </label>

            <label class="onboarding-field">
                <span>@T["Phone"]</span>
                <input asp-for="Phone"
                       type="tel"
                       autocomplete="tel" />
                <span asp-validation-for="Phone"
                      class="text-danger"></span>
            </label>

            <label class="onboarding-field">
                <span>@T["Country"]</span>
                <select asp-for="CountryCode"
                        class="onboarding-country-select"
                        autocomplete="country">
                    <option value="">@T["SelectCountry"]</option>
                    <option value="PL">@T["Country_PL"]</option>
                    <option value="AE">@T["Country_AE"]</option>
                </select>
                <span asp-validation-for="CountryCode"
                      class="text-danger"></span>
            </label>

            <label class="onboarding-field">
                <span>@T["City"]</span>
                <input asp-for="City"
                       autocomplete="address-level2" />
                <span asp-validation-for="City"
                      class="text-danger"></span>
            </label>

            <label class="onboarding-field onboarding-student-count">
                <span>@T["EstimatedStudentCount"]</span>
                <input asp-for="EstimatedStudentCount"
                       type="number"
                       min="500"
                       step="1" />
                <span asp-validation-for="EstimatedStudentCount"
                      class="text-danger"></span>
            </label>

            <label class="onboarding-field onboarding-full">
                <span>@T["Message"]</span>
                <textarea asp-for="Message"
                          rows="5"></textarea>
                <span asp-validation-for="Message"
                      class="text-danger"></span>
            </label>

            <label class="onboarding-consent onboarding-full">
                <input asp-for="PrivacyAccepted"
                       type="checkbox" />
                <span>@T["PrivacyAccepted"]</span>
            </label>

            <span asp-validation-for="PrivacyAccepted"
                  class="text-danger onboarding-full"></span>

            <div class="onboarding-submit-row onboarding-full">
                <button type="submit"
                        class="school-button school-button-primary onboarding-submit">
                    @T["SubmitDemoRequest"]
                </button>
            </div>
        </form>
    </div>
</section>
