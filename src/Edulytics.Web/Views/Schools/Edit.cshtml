@model Edulytics.Web.ViewModels.Schools.SchoolFormViewModel
@inject Microsoft.Extensions.Localization.IStringLocalizer<Edulytics.Web.PlatformResource> T

@{
    ViewData["Title"] = T["Edit"].Value;
}

<section class="school-page school-form-page">
    <header class="school-page-header">
        <div>
            <a class="school-back-link"
               asp-controller="Schools"
               asp-action="Details"
               asp-route-id="@Model.Id">
                ← @T["SchoolDetails"]
            </a>

            <h1>@T["Edit"]</h1>
            <p class="school-page-subtitle">@T["EditIntro"]</p>
        </div>
    </header>

    <form method="post"
          class="school-form"
          novalidate>

        <input asp-for="RowVersionBase64" type="hidden" />

        <div asp-validation-summary="ModelOnly"
             class="school-validation-summary"
             role="alert"></div>

        <div class="school-form-grid">
            <div class="school-field school-field-wide">
                <label asp-for="Name">@T["Name"]</label>
                <input asp-for="Name"
                       autocomplete="organization" />
                <span asp-validation-for="Name"
                      class="school-field-error"></span>
            </div>

            <div class="school-field">
                <label>@T["SchoolCode"]</label>
                <input value="@Model.SchoolCode"
                       readonly
                       aria-readonly="true" />
                <small>@T["ImmutableCodeHelp"]</small>
            </div>

            <div class="school-field">
                <label asp-for="CountryCode">@T["CountryCode"]</label>
                <input asp-for="CountryCode"
                       autocomplete="country" />
                <span asp-validation-for="CountryCode"
                      class="school-field-error"></span>
            </div>

            <div class="school-field">
                <label asp-for="City">@T["City"]</label>
                <input asp-for="City"
                       autocomplete="address-level2" />
                <span asp-validation-for="City"
                      class="school-field-error"></span>
            </div>

            <div class="school-field">
                <label asp-for="ContactEmail">@T["ContactEmail"]</label>
                <input asp-for="ContactEmail"
                       type="email"
                       autocomplete="email" />
                <span asp-validation-for="ContactEmail"
                      class="school-field-error"></span>
            </div>

            <div class="school-field">
                <label asp-for="DefaultCulture">@T["DefaultCulture"]</label>
                <select asp-for="DefaultCulture">
                    <option value="en">@T["CultureEnglish"]</option>
                    <option value="pl">@T["CulturePolish"]</option>
                </select>
                <span asp-validation-for="DefaultCulture"
                      class="school-field-error"></span>
            </div>

            <div class="school-field">
                <label asp-for="TimeZoneId">@T["TimeZoneId"]</label>
                <input asp-for="TimeZoneId" />
                <span asp-validation-for="TimeZoneId"
                      class="school-field-error"></span>
            </div>
        </div>

        <div class="school-form-actions">
            <button type="submit"
                    class="school-button school-button-primary">
                @T["SaveChanges"]
            </button>

            <a class="school-button school-button-ghost"
               asp-controller="Schools"
               asp-action="Details"
               asp-route-id="@Model.Id">
                @T["Cancel"]
            </a>
        </div>
    </form>
</section>
