{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning",
      "Microsoft.EntityFrameworkCore.Database.Command": "Warning"
    }
  },
  "Edulytics": {
    "Production": {
      "WorkerStaleAfterSeconds": 60,
      "DatabaseTimeoutSeconds": 5
    },
    "Hosting": {
      "TrustForwardedHeaders": false,
      "DataProtectionApplicationName": "Edulytics",
      "RequireDataProtectionCertificate": true
    }
  }
}
