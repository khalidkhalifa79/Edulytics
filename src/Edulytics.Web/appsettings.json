{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "Edulytics": {
    "Production": {
      "WorkerStaleAfterSeconds": 60,
      "DatabaseTimeoutSeconds": 5
    },
    "Resilience": {
      "InteractiveReadTimeoutSeconds": 15,
      "InteractiveWriteTimeoutSeconds": 20,
      "ImportTimeoutSeconds": 45,
      "AnalyticsTimeoutSeconds": 30,
      "OperationalTimeoutSeconds": 20,
      "DatabaseCommandTimeoutSeconds": 15,
      "NpgsqlMaxPoolSize": 40,
      "HeavyWritePermitLimit": 8,
      "HeavyWriteQueueLimit": 8,
      "ImportPermitLimit": 2,
      "ImportQueueLimit": 2,
      "AnalyticsPermitLimit": 1,
      "AnalyticsQueueLimit": 1,
      "MaxRequestBodyBytes": 6291456,
      "RequestHeadersTimeoutSeconds": 15,
      "KeepAliveTimeoutSeconds": 120
    }
  },
  "AllowedHosts": "*"
}
