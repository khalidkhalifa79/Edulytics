{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "Edulytics": {
    "Production": {
      "WorkerStaleAfterSeconds": 60,
      "DatabaseTimeoutSeconds": 5
    },
    "Resilience": {
      "InteractiveReadTimeoutSeconds": 15,
      "InteractiveWriteTimeoutSeconds": 20,
      "ImportTimeoutSeconds": 45,
      "AnalyticsTimeoutSeconds": 30,
      "OperationalTimeoutSeconds": 20,
      "DatabaseCommandTimeoutSeconds": 15,
      "NpgsqlMaxPoolSize": 40,
      "HeavyWritePermitLimit": 8,
      "HeavyWriteQueueLimit": 8,
      "ImportPermitLimit": 2,
      "ImportQueueLimit": 2,
      "AnalyticsPermitLimit": 1,
      "AnalyticsQueueLimit": 1,
      "MaxRequestBodyBytes": 6291456,
      "RequestHeadersTimeoutSeconds": 15,
      "KeepAliveTimeoutSeconds": 120
    },
    "OutboxV2": {
      "PollDelayMilliseconds": 300,
      "ErrorDelayMilliseconds": 1000,
      "BatchSize": 20,
      "LeaseSeconds": 30,
      "MessageProcessingTimeoutSeconds": 20,
      "MaxAttempts": 6,
      "RetryBaseSeconds": 2,
      "RetryMaxSeconds": 120,
      "RetryJitterMilliseconds": 750,
      "AnalyticsPollDelayMilliseconds": 250,
      "AnalyticsDebounceMilliseconds": 400,
      "AnalyticsMaxCoalesceMilliseconds": 2000,
      "AnalyticsLeaseSeconds": 60,
      "AnalyticsRefreshTimeoutSeconds": 40,
      "ShutdownGraceSeconds": 45
    },
    "Reports": {
      "MaxHtmlRows": 500,
      "MaxExportRows": 25000,
      "MaxExportBytes": 10485760,
      "ExportRetentionHours": 24,
      "RecentJobsLimit": 20
    },
    "Privacy": {
      "Enabled": true,
      "ImportPayloadRetentionHours": 24,
      "NotificationReadRetentionDays": 180,
      "SweepIntervalMinutes": 15
    },
    "Scale": {
      "Enabled": false,
      "RuntimeRole": "Combined",
      "RequireRedis": false,
      "DistributedSensitiveRateLimitsEnabled": false,
      "ExpectedWebInstances": 2,
      "ExpectedWorkerInstances": 2,
      "DatabaseConnectionBudget": 160,
      "RedisChannelPrefix": "edulytics"
    }
  },
  "AllowedHosts": "*",
  "Email": {
    "Smtp": {
      "TimeoutSeconds": 10,
      "CircuitFailureThreshold": 3,
      "CircuitBreakSeconds": 60
    }
  }
}
